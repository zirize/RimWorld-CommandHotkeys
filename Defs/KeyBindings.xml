  </KeyBindingDef>

  <KeyBindingDef>
    <defName>CommandHotkeys_Toggle_ResourceReadout</defName>
    <label>toggle categorized resource readout</label>
    <category>CommandHotkeys_Toggles</category>
  </KeyBindingDef>

</Defs>
