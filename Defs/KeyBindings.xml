  <KeyBindingDef>
    <defName>CommandHotkeys_Toggle_TerrainAffordanceOverlay</defName>
    <label>toggle terrain affordance overlay</label>
    <category>CommandHotkeys_Toggles</category>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>CommandHotkeys_Toggle_TemperatureOverlay</defName>
    <label>toggle temperature overlay</label>
    <category>CommandHotkeys_Toggles</category>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>CommandHotkeys_Toggle_PollutionOverlay</defName>
    <label>toggle pollution overlay</label>
    <category>CommandHotkeys_Toggles</category>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>CommandHotkeys_Toggle_VacuumOverlay</defName>
    <label>toggle vacuum overlay</label>
    <category>CommandHotkeys_Toggles</category>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>CommandHotkeys_Toggle_ColonistBar</defName>
    <label>toggle colonist bar</label>
    <category>CommandHotkeys_Toggles</category>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>CommandHotkeys_Toggle_LearningHelper</defName>
    <label>toggle learning helper</label>
    <category>CommandHotkeys_Toggles</category>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>CommandHotkeys_Toggle_AutoHomeArea</defName>
    <label>toggle auto home area</label>
    <category>CommandHotkeys_Toggles</category>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>CommandHotkeys_Toggle_AutoRebuild</defName>
    <label>toggle auto rebuild</label>
